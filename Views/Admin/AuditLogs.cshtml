@model IEnumerable<CalendarApp.Models.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>📋 Audit Logs</h1>
            <small class="text-muted">Admin and User Activity Tracking</small>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">← Back to Dashboard</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("g")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.UserName))
                                    {
                                        <strong>@log.UserName</strong>
                                        @if (!string.IsNullOrWhiteSpace(log.UserEmail))
                                        {
                                            <small>(@log.UserEmail)</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Deleted User</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @GetActionBadgeClass(log.Action)">@log.Action</span>
                                </td>
                                <td>@log.Details</td>
                                <td><code>@log.IpAddress</code></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No audit logs found</td>
                        </tr>
                    }
                </tbody>
            </table>

@if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("AuditLogs", new { page = ViewBag.CurrentPage - 1 })">Previous</a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    @if (i == ViewBag.CurrentPage)
                    {
                        <li class="page-item active">
                            <span class="page-link">@i</span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("AuditLogs", new { page = i })">@i</a>
                        </li>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("AuditLogs", new { page = ViewBag.CurrentPage + 1 })">Next</a>
                    </li>
                }
            </ul>
        </nav>
    }
        </div>
    </div>
</div>

@functions {
    string GetActionBadgeClass(string action)
    {
        return action switch
        {
            "AssignRole" => "bg-info",
            "ToggleUserStatus" => "bg-warning",
            "ResetPassword" => "bg-secondary",
            "DeleteUser" => "bg-danger",
            _ => "bg-light"
        };
    }
}
