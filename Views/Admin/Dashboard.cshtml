@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>🔐 Admin Control Panel</h1>
            <small class="text-muted">User and Authentication Management</small>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <h2>@ViewBag.Stats.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Active Users</h5>
                    <h2>@ViewBag.Stats.ActiveUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <h2>@ViewBag.Stats.TotalEvents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Audit Logs</h5>
                    <h2>@ViewBag.Stats.AuditLogs</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Admin Actions</h5>
                </div>
                <div class="card-body">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("ManageUsers", new { adminUserId = ViewBag.AdminUserId })" class="btn btn-primary">👥 Manage Users</a>
                        <a href="@Url.Action("AuditLogs", new { adminUserId = ViewBag.AdminUserId })" class="btn btn-info">📋 View Audit Logs</a>
                        <a href="@Url.Action("Analytics", new { adminUserId = ViewBag.AdminUserId })" class="btn btn-secondary">📊 Analytics</a>
                        <a href="@Url.Action("Index", "Home", new { userId = ViewBag.AdminUserId })" class="btn btn-danger">Back to Calendar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
