@model CalendarApp.Models.User

@{
    ViewData["Title"] = "User Details - " + Model.Name;
}

<div class="container-fluid mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>👤 @Model.Name</h1>
            <small class="text-muted">@Model.Email</small>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("ManageUsers")" class="btn btn-secondary">← Back</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">User Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>ID:</strong> @Model.Id</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Created:</strong> @Model.CreatedAt.ToString("g")</p>
                    <p><strong>Last Login:</strong> @(Model.LastLogin?.ToString("g") ?? "Never")</p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </p>
                    <p>
                        <strong>Role:</strong>
                        <span class="badge bg-warning">@Model.Role</span>
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Statistics</h5>
                </div>
                <div class="card-body">
                    <p><strong>Total Events:</strong> @Model.Events.Count</p>
                    <p><strong>Sent Messages:</strong> @Model.SentMessages.Count</p>
                    <p><strong>Received Messages:</strong> @Model.ReceivedMessages.Count</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Administration Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.Id != ViewBag.AdminUserId)
                    {
                        <form method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="roleValue" class="form-label">Change Role:</label>
                                <div class="input-group">
                                    <select class="form-select" id="roleValue" name="roleValue" required>
                                        @foreach (CalendarApp.Models.UserRole role in ViewBag.Roles)
                                        {
                                            if (Model.Role == role)
                                            {
                                                <option value="@((int)role)" selected="selected">@role</option>
                                            }
                                            else
                                            {
                                                <option value="@((int)role)">@role</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-primary" formaction="@Url.Action("AssignRole", new { userId = Model.Id })">Assign</button>
                                </div>
                            </div>
                        </form>

                        <form method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn @(Model.IsActive ? "btn-danger" : "btn-success") w-100"
                                    formaction="@Url.Action("ToggleUserStatus", new { userId = Model.Id })"
                                    onclick="return confirm('Are you sure?');">
                                @(Model.IsActive ? "Deactivate User" : "Activate User")
                            </button>
                        </form>

                        <form method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-warning w-100"
                                    formaction="@Url.Action("ResetPassword", new { userId = Model.Id })"
                                    onclick="return confirm('Reset password for this user?');">
                                🔑 Reset Password
                            </button>
                        </form>

                        <form method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    formaction="@Url.Action("DeleteUser", new { userId = Model.Id })"
                                    onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                🗑️ Delete User
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            You cannot modify your own account from here.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Events.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Recent Events (@Model.Events.Count)</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Date</th>
                                    <th>Category</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Events.OrderByDescending(e => e.CreatedAt).Take(5))
                                {
                                    <tr>
                                        <td>@item.Title</td>
                                        <td>@item.StartTime.ToString("g")</td>
                                        <td><span class="badge bg-info">@item.Category</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>