@model CalendarApp.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>Delete Event</h1>
            <div class="alert alert-warning">
                <p>Are you sure you want to delete this event?</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <p><strong>Title:</strong> @Model.Title</p>
                    <p><strong>Date:</strong> @Model.StartTime.ToString("dddd, MMMM d, yyyy")</p>
                    <p><strong>Description:</strong> @Model.Description</p>
                </div>
            </div>

            <div class="mt-4">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a href="@Url.Action("Index", new { userId = Model.UserId })" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
